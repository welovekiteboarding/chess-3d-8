{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "tsBuildInfoFile": "./node_modules/tsconfig.node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "eslint.config.js", "prettier.config.js"]
}
